# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*.swo
*.orig

# Logs (keep directory structure, ignore generated content)
logs/daily/*.md
logs/weekly/*.md
!logs/.gitkeep

# Projects scaffolded locally (each manages its own git)
projects/

# Secrets and credentials — prevent accidental commit via git add .
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
serviceAccountKey*.json
*-credentials.json
*.token
.aws/
.gcp/
.azure/
.netrc
.npmrc
.pypirc

# Outputs (may contain PII, cloud resource IDs, or operational data)
outputs/*.json
outputs/*.html
outputs/*.md
!outputs/README.md

# Temp
/tmp/
*.tmp
