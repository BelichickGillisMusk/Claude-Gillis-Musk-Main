# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*.swo
*.orig

# Logs (keep directory structure, ignore generated content)
logs/daily/*.md
logs/weekly/*.md
!logs/.gitkeep

# Projects scaffolded locally (each manages its own git)
projects/

# Secrets and credentials — prevent accidental commit via git add .
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
serviceAccountKey*.json
**/service-account*.json
*-credentials.json
*.secret
secret.*
.aws/
.gcp/
.azure/
*.token
.netrc
.npmrc
.pypirc

# Temp
/tmp/
*.tmp
